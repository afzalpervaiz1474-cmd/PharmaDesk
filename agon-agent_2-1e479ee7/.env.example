# PharmaDesk - example environment file for the desktop UI and browser preview.
# Copy to `.env` for local use. Never commit `.env`.
#
# The backend has its own file: backend/.env.example
# Every value here is a placeholder. No real credential belongs in this file.

# --- Desktop UI (Vite) ----------------------------------------------------
# WARNING: every VITE_* variable is compiled into the app and readable by
# anyone who has it. Never put a secret or API key in a VITE_* variable.

# Optional. Pre-fills the backend address on the "Sync & settings" screen.
VITE_API_BASE_URL=

# --- Hosted browser preview only (api/ serverless functions) --------------
# Not needed for the desktop app or the NestJS backend.
# The preview stores its demo data in a Supabase (PostgreSQL) project.
NEXT_PUBLIC_SUPABASE_URL=
# Server-side only. Grants full database access - treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=
