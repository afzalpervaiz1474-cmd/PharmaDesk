backend/.env
backend/.env.*
!backend/.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets/

# --- Databases ------------------------------------------------------------
# Local SQLite files hold real store data.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# --- Logs -----------------------------------------------------------------
logs/
*.log
npm-debug.log*

