# PharmaDesk backend - example configuration.
# Copy to `backend/.env` and fill in real values. Never commit `.env`.
# Every value below is a placeholder; none of them is a working credential.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Origins allowed to call the API from a browser/webview, comma separated.
# http://localhost:1420  -> `npm run tauri:dev`
# tauri://localhost      -> packaged app on macOS and Linux
# http://tauri.localhost -> packaged app on Windows
CORS_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost,http://tauri.localhost

# --- PostgreSQL -----------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://pharmadesk:replace-with-your-password@localhost:5432/pharmadesk
# Set to true when the database requires TLS (most hosted providers).
DATABASE_SSL=false

# --- Authentication -------------------------------------------------------
# Secret used to sign access tokens. Must be at least 32 characters.
# Generate one with:  openssl rand -hex 32
# The server refuses to start in production while this still says "change-me".
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN_SECONDS=43200
# Set to false to stop new stores from registering on this server.
AUTH_ALLOW_REGISTRATION=true

# --- AI assistant (OmniRoute gateway) -------------------------------------
# Optional. Leave OMNIROUTE_API_KEY empty to run the assistant in data-lookup
# mode (direct database lookups, no language model).
# The key is read by the server only. It is never sent to the desktop app.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
# Model or routing rule exactly as shown in your OmniRoute dashboard.
OMNIROUTE_MODEL=
OMNIROUTE_TIMEOUT_MS=30000
