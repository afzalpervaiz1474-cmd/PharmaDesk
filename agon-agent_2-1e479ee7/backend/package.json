{
  "name": "pharmadesk-backend",
  "version": "0.1.0",
  "description": "PharmaDesk cloud backend: REST API, authentication, sync and the AI gateway integration",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "nest build && node dist/database/migrate.js",
    "migrate:prod": "node dist/database/migrate.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=src/",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=test/"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
